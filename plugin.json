{
  "id": "netease",
  "name": "NetEase Cloud Music",
  "version": "0.1.0",
  "minAppVersion": "0.1.20",
  "main": "index.ts",
  "playback": "stream",
  "permissions": {
    "network": ["music.163.com", "interface.music.163.com", "*.music.126.net"]
  },
  "settings": [
    {
      "key": "preferHiRes",
      "label": "Prefer Hi-Res",
      "type": "boolean",
      "help": "When the app's quality is Lossless, ask for Hi-Res first. Type true or false if your app shows a text field."
    }
  ],
  "navigation": [
    { "builtin": "home" },
    { "title": "Charts", "page": "charts", "icon": "chart" },
    { "builtin": "savedAlbums" }
  ]
}
